{
  // GitHub Codespaces / VS Code dev container: DIAL with demo data, SQLite and no Redis.
  // Open the forwarded port 8000 and log in as admin@dial.local / admin.
  "name": "DIAL",
  "image": "mcr.microsoft.com/devcontainers/python:1-3.12-bookworm",
  "hostRequirements": {"cpus": 2},
  "postCreateCommand": "bash .devcontainer/setup.sh",
  "postStartCommand": "bash .devcontainer/start.sh",
  "forwardPorts": [8000],
  "portsAttributes": {
    "8000": {"label": "DIAL", "onAutoForward": "openBrowser"}
  },
  "customizations": {
    "codespaces": {"openFiles": [".devcontainer/README.md"]},
    "vscode": {"extensions": ["ms-python.python", "charliermarsh.ruff"]}
  }
}
