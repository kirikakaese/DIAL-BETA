# DIAL venue box - environment for docker-compose.venue.example.yml (and /etc/dial-venue-agent.env on bare metal).
#   cp .env.venue.example .env.venue && chmod 0600 .env.venue
# The hook secret grants READ access to this event's SIP credentials - never commit this file.

# --- central DIAL ------------------------------------------------------------------------------
DIAL_URL=https://dial.example.org
DIAL_EVENT=demo
# event hook secret from /e/<slug>/pbx/ ("PBX connection") - also used by Asterisk for hooks/route API
DIAL_PBX_HOOK_SECRET=change-me
# alternative: a DIAL service token instead of the hook secret (sent as "Authorization: Bearer ...")
#DIAL_SYNC_TOKEN=
# fixed poll interval in seconds; unset = follow the server's poll_interval (default 15)
#POLL_INTERVAL=15
#HTTP_TIMEOUT=10
#LOG_LEVEL=INFO
# extra CA certificate when DIAL uses a private CA (added to the system bundle)
#TLS_CA_FILE=/etc/dial/venue-ca.crt
# NEVER in production - disables TLS certificate verification
#INSECURE_SKIP_VERIFY=0

# --- local PostgreSQL (venue-db) ---------------------------------------------------------------
VENUE_DB_USER=asterisk
VENUE_DB_PASSWORD=change-me-too
VENUE_DB_NAME=asterisk

# --- Asterisk credentials (compose passes them to both containers) -----------------------------
ASTERISK_ARI_USER=dial
ASTERISK_ARI_PASSWORD=change-me-three
ASTERISK_AMI_USER=dial
ASTERISK_AMI_PASSWORD=change-me-four
ASTERISK_SIP_DOMAIN=dial.local
# host LAN IP when the asterisk container runs on a bridge network (NAT)
EXTERNAL_IP=
# number dialled for emergency calls when DIAL is unreachable / has no emergency route
DIAL_EMERGENCY_FALLBACK=

# --- bare metal only (systemd) - compose sets these itself --------------------------------------
#DB_HOST=127.0.0.1
#DB_PORT=5432
#DB_NAME=asterisk
#DB_USER=asterisk
#DB_PASSWORD=change-me-too
#AMI_HOST=127.0.0.1
#AMI_PORT=5038
#AMI_USER=dial
#AMI_PASSWORD=change-me-four
# without AMI_HOST the agent runs this shell command after every applied snapshot ("" disables):
#ASTERISK_RELOAD=asterisk -rx "module reload res_pjsip.so" && asterisk -rx "dialplan reload" && asterisk -rx "module reload app_voicemail.so"
#STATE_DIR=/var/lib/dial-venue-agent
