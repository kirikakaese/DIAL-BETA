# DIAL - DECT & IP Administration Layer: environment configuration
#
#   cp .env.example .env
#
# Read by Django (dial/settings/base.py via django-environ) and by docker compose
# (env_file for web/worker/beat + ${VAR} interpolation in docker-compose.yml).
# Container-to-container URLs (DATABASE_URL, REDIS_URL, ASTERISK_*_URL/HOST) are
# fixed inside docker-compose.yml, so the values below can stay laptop-friendly
# for `make run`.

# ----------------------------------------------------------------------------
# Core
# ----------------------------------------------------------------------------
# Secret key - REQUIRED in production. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=change-me-generate-a-real-secret-key
# Debug mode (never 1 in production)
DEBUG=0
# Comma-separated hostnames the site may be served under
ALLOWED_HOSTS=*
# Comma-separated origins allowed for CSRF (scheme + host [+ port])
CSRF_TRUSTED_ORIGINS=http://localhost:8000
# Public base URL used in e-mails, QR codes and provisioning links
DIAL_PUBLIC_URL=http://localhost:8000
# Installable web app (manifest + service worker; needs HTTPS or localhost). 0 = no manifest link, /sw.js
# answers 404 and installed workers unregister. Colours are used by the manifest / splash screen.
#DIAL_PWA_ENABLED=1
#DIAL_PWA_THEME_COLOR=#3b82f6
#DIAL_PWA_BACKGROUND_COLOR=#0e1015
# Server time zone (the web UI is English only)
TIME_ZONE=Europe/Berlin
# Where uploaded files / imported voicemail audio are stored (compose: /app/media)
MEDIA_ROOT=media
# Root log level (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO

# Early-access gate: a shared password in front of the whole site while the instance runs on its public
# domain but is not open to everyone yet. Empty = off. Changing it locks every browser out again.
# Phones (/prov/), Asterisk hooks (X-DIAL-PBX-Secret), the remote phonebook and API calls with a dial_
# service token are not affected.
DIAL_EARLY_ACCESS_PASSWORD=
DIAL_EARLY_ACCESS_DAYS=30
DIAL_EARLY_ACCESS_MESSAGE=

# ----------------------------------------------------------------------------
# Database / Redis  (compose overrides both with the db/redis containers)
# ----------------------------------------------------------------------------
# postgres://user:pass@host:5432/dbname  or  sqlite:///dial.sqlite3 for a laptop
DATABASE_URL=sqlite:///dial.sqlite3
# Redis: cache + Celery broker/result backend
REDIS_URL=redis://localhost:6379/0
# 1 = run Celery tasks inline (no worker needed; dev/test), 0 = real worker
CELERY_TASK_ALWAYS_EAGER=1

# ----------------------------------------------------------------------------
# Email
# ----------------------------------------------------------------------------
# consolemail:// (log to stdout), smtp://user:pass@host:587?tls=True, smtp+ssl://...
EMAIL_URL=consolemail://
# Sender address for registration mails, voicemail notifications, alerts
DEFAULT_FROM_EMAIL=dial@example.org
# 1 = e-mail-first signup: users get a confirmation link and only then choose
#     nickname/password (default, recommended). Accounts that are still unverified
#     (created while this was 0) cannot register extensions until they verify.
# 0 = one-step signup, a verification mail is sent afterwards (dev/demo).
DIAL_REQUIRE_EMAIL_VERIFICATION=1
# Hours a registration / verification / e-mail-change link stays valid
DIAL_EMAIL_TOKEN_TTL_HOURS=48
# Spam guard on signup / login / password reset: hidden honeypot field + a form
# must be open for at least N seconds before it is accepted (0 = timing off)
DIAL_SPAM_GUARD=1
DIAL_SPAM_GUARD_MIN_SECONDS=3
# Sign-up e-mail domain policy (comma separated). Blocked: e.g. disposable
# providers. Allowed: if set, only these domains (and subdomains) may sign up.
DIAL_SIGNUP_BLOCKED_DOMAINS=
DIAL_SIGNUP_ALLOWED_DOMAINS=
# Login lockout: wrong passwords per account / per IP within 15 min, lock duration
DIAL_LOGIN_MAX_FAILURES=5
DIAL_LOGIN_IP_MAX_FAILURES=30
DIAL_LOGIN_LOCKOUT_MINUTES=15

# --- OpenID Connect login (optional) -----------------------------------------
# Authorization code flow + PKCE against Keycloak, Authentik, Zitadel, ...
# Register a client at the IdP with redirect URI <DIAL_PUBLIC_URL>/accounts/oidc/callback/
# and check the setup with:  manage.py dial_oidc_check
#DIAL_OIDC_ENABLED=1
#DIAL_OIDC_ISSUER=https://id.example.org/realms/dial
#DIAL_OIDC_CLIENT_ID=dial
#DIAL_OIDC_CLIENT_SECRET=change-me
#DIAL_OIDC_SCOPES=openid email profile
#DIAL_OIDC_BUTTON_LABEL=Log in with SSO
# 1 = create a DIAL account on first SSO login, 0 = only existing/linked accounts
#DIAL_OIDC_AUTO_CREATE=1
# 1 = trust the IdP's email_verified claim (no separate DIAL e-mail confirmation)
#DIAL_OIDC_TRUST_EMAIL_VERIFIED=1
# 0 = SSO only: hide password login, signup and reset (superusers keep /admin/login/)
#DIAL_OIDC_ALLOW_PASSWORD_LOGIN=1
# Claim used as nickname for new accounts (fallback: local part of the e-mail)
#DIAL_OIDC_USERNAME_CLAIM=preferred_username
# 1 = logging out of DIAL also ends the IdP session (end_session_endpoint)
#DIAL_OIDC_LOGOUT_AT_IDP=0

# ----------------------------------------------------------------------------
# PBX (Asterisk) - SERVER DEFAULT
# ----------------------------------------------------------------------------
# DIAL is one central service; each event connects its own venue Asterisk on /e/<slug>/pbx/ (ARI/AMI,
# hook secret). The settings here are the fallback for events without such a connection (single-event
# box, lab, demo). apps.pbx.backends.asterisk.AsteriskPBX (real) or apps.pbx.backends.dummy.DummyPBX
DIAL_PBX_BACKEND=apps.pbx.backends.asterisk.AsteriskPBX
# Asterisk REST Interface base URL (compose: http://asterisk:8088/ari)
ASTERISK_ARI_URL=http://localhost:8088/ari
# ARI credentials - must match the Asterisk container's ARI_USER / ARI_PASSWORD
ASTERISK_ARI_USER=dial
ASTERISK_ARI_PASSWORD=dial
# Stasis application name registered by DIAL
ASTERISK_ARI_APP=dial
# Asterisk Manager Interface host/port (compose: asterisk:5038)
ASTERISK_AMI_HOST=localhost
ASTERISK_AMI_PORT=5038
# AMI credentials - must match the Asterisk container's AMI_USER / AMI_PASSWORD
ASTERISK_AMI_USER=dial
ASTERISK_AMI_PASSWORD=dial
# SIP digest realm / TLS certificate CN - must match the container's SIP_DOMAIN
ASTERISK_SIP_DOMAIN=dial.local
# Directory where Asterisk writes IVR announcements recorded by phone (record-announcement service) and
# DIAL imports them from. Must be ONE volume mounted in web, worker and the Asterisk container
# (compose: `recordings`). Asterisk can override its write path with DIAL_RECORD_DIR.
#DIAL_RECORDING_DIR=/var/spool/asterisk/dial-recordings
# Read-only LDAP phonebook server (`manage.py dial_ldap`, compose service `ldap`): desk phones / the DECT OMM
# bind as cn=directory,dc=<event>,dc=dial with the event's directory token, base ou=phonebook,dc=<event>,dc=dial.
# Port (compose: host port published for the ldap service), anonymous binds (1 = any client may search
# every event - LAN only!), seconds the per-event entry list is cached.
#DIAL_LDAP_PORT=3890
#DIAL_LDAP_ALLOW_ANONYMOUS=0
#DIAL_LDAP_CACHE_SECONDS=30

# ----------------------------------------------------------------------------
# DECT (Mitel/Aastra OMM) - SERVER DEFAULT
# ----------------------------------------------------------------------------
# Like the PBX: events connect their venue OMM on /e/<slug>/pbx/; this is the fallback.
# apps.dect.backends.dummy.DummyDECT (no hardware) or apps.dect.backends.omm.MitelOMM
DIAL_DECT_BACKEND=apps.dect.backends.dummy.DummyDECT
# OM Application XML interface host (empty = disabled)
OMM_HOST=
# OMM AXI port (12622 = TLS)
OMM_PORT=12622
# OMM API user / password
OMM_USER=omm
OMM_PASSWORD=
# Verify the OMM TLS certificate (OMMs usually ship self-signed certs)
OMM_VERIFY_TLS=0

# ----------------------------------------------------------------------------
# Alerting
# ----------------------------------------------------------------------------
# Generic webhook (JSON POST) for infrastructure / emergency alerts
ALERT_WEBHOOK_URL=
# ntfy.sh topic URL, e.g. https://ntfy.sh/dial-alerts
NTFY_URL=
# Comma-separated e-mail recipients for alerts
ALERT_EMAILS=

# ----------------------------------------------------------------------------
# Features
# ----------------------------------------------------------------------------
# Comma-separated list of enabled optional features; empty = defaults
# (phonebook,callgroups,voicemail,stats,guest_extensions,waitlist,webhooks,emergency).
# All: phonebook,callgroups,voicemail,stats,messaging,ivr,conferences,federation,
#      breakout,emergency,guest_extensions,waitlist,webhooks
DIAL_FEATURES=
# Days to keep call detail records (0 = forever)
DIAL_CDR_RETENTION_DAYS=30

# ----------------------------------------------------------------------------
# Security (dial.settings.prod)
# ----------------------------------------------------------------------------
# Cookies only over HTTPS - set both to 1 behind a TLS reverse proxy
SESSION_COOKIE_SECURE=0
CSRF_COOKIE_SECURE=0
# HTTP Strict Transport Security max-age in seconds (0 = off; 31536000 once TLS works)
SECURE_HSTS_SECONDS=0
# CORS for external API clients
CORS_ALLOW_ALL_ORIGINS=0
CORS_ALLOWED_ORIGINS=

# ----------------------------------------------------------------------------
# Compose-only (docker-compose.yml, deploy/asterisk)
# ----------------------------------------------------------------------------
# PostgreSQL container credentials (DATABASE_URL inside compose is built from these)
POSTGRES_USER=dial
POSTGRES_PASSWORD=dial
POSTGRES_DB=dial
# Asterisk ARI / AMI accounts (mirrored into ASTERISK_ARI_* / ASTERISK_AMI_* for DIAL)
ARI_USER=dial
ARI_PASSWORD=dial
AMI_USER=dial
AMI_PASSWORD=dial
# Shared secret for Asterisk -> DIAL hooks; DIAL compares against ASTERISK_ARI_PASSWORD,
# so keep this equal to ARI_PASSWORD. Avoid ; $ { } and newlines.
DIAL_PBX_HOOK_SECRET=dial
# SIP realm for the Asterisk container (= ASTERISK_SIP_DOMAIN)
SIP_DOMAIN=dial.local
# Host LAN IP for SIP/RTP behind docker bridge NAT (empty = not set)
EXTERNAL_IP=
# Event slugs Asterisk pre-creates dialplan contexts for if DIAL is down at boot
DIAL_EVENTS=demo
# Number Asterisk dials when DIAL has no emergency route (empty = none)
DIAL_EMERGENCY_FALLBACK=
# yes = Asterisk POSTs every CDR to DIAL (otherwise the ingest_cdrs sweep is used)
DIAL_CDR_HOOK=no
# gunicorn worker processes
WEB_CONCURRENCY=3
# 1 = run `manage.py seed_demo` on web start (admin@dial.local / admin, event "demo")
DIAL_SEED_DEMO=1
# PBX outbox: leave empty to follow CELERY_TASK_ALWAYS_EAGER; set true/false to force sync/async delivery
DIAL_PBX_OUTBOX_SYNC=
